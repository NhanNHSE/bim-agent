# === BIM AI Agent — Environment Configuration ===
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# === LLM ===
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODEL=gemini-2.5-flash-lite

# === Retrieval ===
RETRIEVAL_TOP_K=15
RERANK_TOP_K=5

# === Neo4j ===
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# === Qdrant ===
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=qcvn_chunks

# === PostgreSQL ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=bim_agent
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=bim_agent_db

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === Auth ===
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# === App ===
APP_NAME=BIM AI Agent
APP_VERSION=0.2.0
DEBUG=true

# === Agent ===
AGENT_MODE=multi_agent

# === Rate limits (per user) ===
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_DAY=300
CHAT_MAX_MESSAGE_CHARS=4000
IFC_RATE_LIMIT_PER_MINUTE=5

# === IFC ===
IFC_UPLOAD_DIR=data/ifc
